/*
  X-Content-Type-Options: nosniff
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/auth.html
  Cache-Control: public, max-age=0, must-revalidate
/fbauth.html
  Cache-Control: public, max-age=0, must-revalidate
/FluxHelper.exe
  Cache-Control: public, max-age=0, must-revalidate
/FluxHelper.apk
  Cache-Control: public, max-age=0, must-revalidate
/manifest.json
  Cache-Control: public, max-age=0, must-revalidate
/icon-192.png
  Cache-Control: public, max-age=604800
/icon-512.png
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/favicon-32.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/iphone
  Cache-Control: public, max-age=0, must-revalidate
/iphone/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

/iphone/*
  Cache-Control: no-cache
/mac/*
  Cache-Control: no-cache
/main
  Cache-Control: no-cache
/main/*
  Cache-Control: no-cache

# 3.5.45: ревізовані ассети (?v=3545) кешуються на добу — повторні
# відкриття сайту не качають 660KB css/js заново (просив власник:
# «сайт загружается очень долго»). HTML лишається no-cache, тож нова
# версія приїде одразу після деплою (/?v= змінюється разом з файлами).
/iphone/ui.css
  Cache-Control: public, max-age=86400
/iphone/ui.js
  Cache-Control: public, max-age=86400
/iphone/webhost.js
  Cache-Control: public, max-age=86400
/iphone/logo.png
  Cache-Control: public, max-age=604800
/mac/ui.css
  Cache-Control: public, max-age=86400
/mac/ui.js
  Cache-Control: public, max-age=86400
/mac/webhost.js
  Cache-Control: public, max-age=86400
/mac/logo.png
  Cache-Control: public, max-age=604800
