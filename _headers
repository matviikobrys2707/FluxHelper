/auth.html
  Cache-Control: public, max-age=0, must-revalidate
/fbauth.html
  Cache-Control: public, max-age=0, must-revalidate
/FluxHelper.exe
  Cache-Control: public, max-age=0, must-revalidate
/FluxHelper.apk
  Cache-Control: public, max-age=0, must-revalidate
/manifest.json
  Cache-Control: public, max-age=0, must-revalidate
/icon-192.png
  Cache-Control: public, max-age=604800
/icon-512.png
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/favicon-32.png
  Cache-Control: public, max-age=604800
