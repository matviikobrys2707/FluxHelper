# 3.5.45: HTML версій — ЗАВЖДИ свіжий (no wildcard: Pages СКЛЕЮЄ заголовки
# з правилів, тож /iphone/* no-cache нейтралізував би кеш ассетів нижче)
/iphone/index.html
  Cache-Control: public, max-age=0, must-revalidate
/iphone/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
/mac/index.html
  Cache-Control: public, max-age=0, must-revalidate

# 3.5.45: ревізовані ассети (?v=3545) кешуються — повторні відкриття сайту
# не качають ~660KB css/js заново (просив власник: «сайт загружается очень
# долго»). При зміні ui.js/ui.css/webhost.js/logo.png ПІДВИЩУЙ ?v= у
# main/index.html — нова версия приїде миттєво, без очікування кеша.
/iphone/ui.css
  Cache-Control: public, max-age=86400
/iphone/ui.js
  Cache-Control: public, max-age=86400
/iphone/webhost.js
  Cache-Control: public, max-age=86400
/iphone/logo.png
  Cache-Control: public, max-age=604800
/mac/ui.css
  Cache-Control: public, max-age=86400
/mac/ui.js
  Cache-Control: public, max-age=86400
/mac/webhost.js
  Cache-Control: public, max-age=86400
/mac/logo.png
  Cache-Control: public, max-age=604800
