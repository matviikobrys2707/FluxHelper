// FluxHelper — ресурси (іконка + WebView2Loader.dll + VERSIONINFO).
// Blazix = автор/видавець, FluxHelper = назва програми (без пробілів).
// VERSIONINFO = «свої» версія/видавець у властивостях файлу Windows
// (ПКМ -> Властивості -> Детально і підказка при наведенні на exe).
#pragma code_page(65001)
#include "version.h"

// константи RC, які llvm-rc не визначає сам
#ifndef VOS_NT_WINDOWS32
#define VOS_NT_WINDOWS32 0x00040004L
#endif
#ifndef VFT_APP
#define VFT_APP 0x00000001L
#endif

1 ICON "build/logo.ico"
101 RCDATA "WebView2Loader.dll"

1 VERSIONINFO
FILEVERSION     FH_VER_MAJ, FH_VER_MIN, FH_VER_PAT, 0
PRODUCTVERSION  FH_VER_MAJ, FH_VER_MIN, FH_VER_PAT, 0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      FH_PUBLISHER
            VALUE "FileDescription",  FH_DESC
            VALUE "FileVersion",      FH_VER_STR
            VALUE "InternalName",     FH_PRODUCT
            VALUE "LegalCopyright",   FH_PUBLISHER
            VALUE "OriginalFilename", "FluxHelper.exe"
            VALUE "ProductName",      FH_PRODUCT
            VALUE "ProductVersion",   FH_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
